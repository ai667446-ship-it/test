 "lines": [
  {
   "layout": "high",
   "en": "there's nothing here, yet there's something"
  },
  {
   "layout": "vright",
   "en": "I keep walking with that feeling"
  },
  {
   "layout": "high",
   "en": "even these nameless days"
  },
  {
   "layout": "vleft",
   "en": "aren't so bad after all, are they"
  },
  {
   "layout": "high",
   "en": "no money, and my dreams are vague"
  },
  {
   "layout": "high",
   "en": "but I still get hungry, it seems"
  },
  {
   "layout": "high",
   "en": "laughing through the days I can't laugh"
  },
  {
